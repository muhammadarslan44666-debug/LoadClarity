    "carrier_id": {
      "type": "string"
    },
    "load_number": {
      "type": "string"
    },
    "broker_id": {
      "type": "string"
    },
    "broker_name": {
      "type": "string"
    },
    "broker_reference": {
      "type": "string"
    },
    "broker_mc": {
      "type": "string"
    },
    "broker_phone": {
      "type": "string"
    },
    "broker_email": {
      "type": "string"
    },
    "pickup_company": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_city": {
      "type": "string"
    },
    "pickup_state": {
      "type": "string"
    },
    "pickup_zip": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
