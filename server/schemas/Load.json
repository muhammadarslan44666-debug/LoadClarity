        "dry_van",
        "reefer",
        "flatbed",
        "box_truck",
        "other"
      ],
      "default": "dry_van"
    },
    "rate": {
      "type": "number"
    },
    "loaded_miles": {
      "type": "number"
    },
    "deadhead_miles": {
      "type": "number"
    },
    "detention_terms": {
      "type": "string"
    },
    "layover_terms": {
      "type": "string"
    },
    "tonu_terms": {
      "type": "string"
    },
    "lumper_terms": {
      "type": "string"
    },
    "lumper_amount": {
      "type": "number"
    },
    "other_accessorials": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "truck_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "ready",
        "booked",
        "driver_assigned",
        "at_pickup",
        "loading",
        "in_transit",
        "at_delivery",
        "delivered",
        "pod_pending",
        "billing_review",
        "billing_ready",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "exception_flag": {
      "type": "boolean",
      "default": false
    },
    "fee_mode": {
      "type": "string",
      "enum": [
        "percent",
        "flat"
      ]
    },
    "fee_percent": {
      "type": "number"
    },
    "fee_flat": {
      "type": "number"
    },
    "fee_base": {
      "type": "string",
      "enum": [
        "gross",
        "net"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "take",
        "counter",
        "pass"
      ]
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "counter_rate": {
      "type": "number"
    },
    "counter_note": {
      "type": "string"
    },
    "pass_reason": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "pod_present": {
      "type": "boolean",
      "default": false
    },
    "bol_present": {
      "type": "boolean",
      "default": false
    },
    "ratecon_present": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_id"
  ]
}
