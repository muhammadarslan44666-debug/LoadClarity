      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "delivery_state": {
      "type": "string"
    },
    "delivery_zip": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_appointment": {
      "type": "string"
    },
    "commodity": {
      "type": "string"
    },
    "weight_lb": {
      "type": "number"
    },
