# Copy this file to ".env" (same folder) and edit. Every line is optional.

# Port for the server (default 5000)
PORT=5000

# Address of the website, used in password-reset links printed in the server window
APP_URL=http://localhost:5173

# Long random text used to sign logins. If empty, one is created automatically in the data folder.
SESSION_SECRET=

# Optional: lets "Quick check" read pasted broker offers with AI.
# Get a key at console.anthropic.com. Leave empty to type numbers by hand.
ANTHROPIC_API_KEY=

# Lemon Squeezy billing (checkout overlay remains the frontend payment method).
# Configure this webhook URL in Lemon Squeezy: https://YOUR_DOMAIN/api/billing/lemonsqueezy-webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Use the six real variant IDs from your Lemon Squeezy store. Monthly/yearly variants map to the same internal plan.
LEMON_VARIANT_SOLO_MONTHLY=
LEMON_VARIANT_SOLO_YEARLY=
LEMON_VARIANT_PRO_MONTHLY=
LEMON_VARIANT_PRO_YEARLY=
LEMON_VARIANT_TEAM_MONTHLY=
LEMON_VARIANT_TEAM_YEARLY=
